# Copy to .env and adjust for local dev. Never commit the real .env file.

# SQLAlchemy connection string. SQLite by default; swap for Postgres etc. without code changes.
DATABASE_URL=sqlite:///./data/onboarding.db

# Directory where uploaded KYC documents are stored on disk.
STORAGE_ROOT=./storage

# Maximum accepted upload size, in megabytes.
MAX_UPLOAD_SIZE_MB=10

# Comma-separated list of origins allowed to call the API (the frontend dev server).
ALLOWED_ORIGINS=http://localhost:5173

# Prefix used when generating application reference IDs, e.g. ONB-2026-00042.
REFERENCE_ID_PREFIX=ONB

# Anthropic API key used for document extraction (US-09..US-12). Leave blank
# for local dev without AI access — extraction degrades gracefully to
# "AI unavailable, routed for manual review" rather than failing requests.
ANTHROPIC_API_KEY=

# Vision-capable model used for identity document extraction.
LLM_MODEL_NAME=claude-sonnet-5

# How long to wait for the LLM before treating it as unavailable.
LLM_TIMEOUT_SECONDS=30

# Extracted fields with confidence below this are flagged as low-confidence.
LOW_CONFIDENCE_THRESHOLD=0.7

# Applicants below this age are flagged during risk assessment (advisory only).
MINIMUM_APPLICANT_AGE=18

# Applications waiting longer than this (in PENDING_REVIEW) are marked overdue in the queue.
OVERDUE_THRESHOLD_HOURS=24

# Directory of sample policy/FAQ documents ingested by the RAG assistant.
POLICY_DOCUMENTS_DIR=./policy_documents

# Where the local Chroma vector store persists its data.
CHROMA_PERSIST_DIR=./data/chroma

# Chunk size/overlap for policy document ingestion, in characters.
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=100

# How many chunks to retrieve per question.
RAG_TOP_K=4
